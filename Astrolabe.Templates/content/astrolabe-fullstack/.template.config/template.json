{
  "$schema": "http://json.schemastore.org/template",
  "author": "Astrolabe Team",
  "classifications": ["Web", "Full Stack", "React", "ASP.NET Core", "Next.js"],
  "identity": "Astrolabe.FullStack.Template",
  "name": "Astrolabe Full Stack Application",
  "shortName": "astrolabe",
  "description": "A full-stack application template with ASP.NET Core backend and Next.js frontend using the Astrolabe framework",
  "sourceName": "AstrolabeApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },

  "symbols": {
    "ProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "__ProjectName__",
      "fileRename": "__ProjectName__"
    },
    "SolutionName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "The name of the solution (defaults to ProjectName if empty)"
    },
    "SolutionNameComputed": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "SolutionName",
        "fallbackVariableName": "ProjectName"
      },
      "replaces": "__SolutionName__"
    },
    "ProjectNameSanitized": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "ProjectName",
        "steps": [
          { "regex": "[^a-zA-Z0-9_]", "replacement": "_" },
          { "regex": "^([0-9])", "replacement": "_$1" }
        ]
      },
      "replaces": "__Namespace__"
    },
    "IncludeDemoData": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include demo data (Tea model, controller, and UI pages)"
    },
    "IncludeDemoDataLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "IncludeDemoData",
        "toLower": true
      },
      "replaces": "__IncludeDemoDataJson__"
    },
    "SiteName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "dashboard",
      "fileRename": "__SiteName__",
      "replaces": "__SiteName__"
    },
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "5000",
      "replaces": "__HttpPort__"
    },
    "HttpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "5001",
      "replaces": "__HttpsPort__"
    },
    "SpaPort": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "8000",
      "replaces": "__SpaPort__"
    },
    "SkipSetup": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip automatic setup orchestration"
    },
    "IncludeOrleans": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Orleans distributed actor framework with tea-themed demo grains"
    },
    "IncludeOrleansLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "IncludeOrleans",
        "toLower": true
      },
      "replaces": "__IncludeOrleansJson__"
    }
  },

  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**",
            "**/.next/**"
          ]
        },
        {
          "condition": "(!IncludeDemoData)",
          "exclude": [
            "Models/Tea.cs",
            "Controllers/TeasController.cs",
            "Data/DbSeeder.cs",
            "Forms/TeaEdit.cs",
            "Forms/TeaSearchPage.cs",
            "Forms/FieldOption.cs",
            "Services/TeaService.cs",
            "ClientApp/sites/__SiteName__/src/app/tea/**",
            "ClientApp/sites/__SiteName__/src/app/form-demo/**",
            "ClientApp/sites/__SiteName__/src/app/search/**"
          ]
        },
        {
          "condition": "(SkipSetup)",
          "exclude": ["astrolabe-setup/**/*"]
        },
        {
          "condition": "(!IncludeOrleans)",
          "exclude": [
            "Grains/**",
            "Controllers/TeaRoomController.cs",
            "ClientApp/sites/__SiteName__/src/app/tearoom/**"
          ]
        }
      ],
      "rename": {
        "AstrolabeApp.csproj": "__ProjectName__.csproj"
      }
    }
  ],

  "postActions": [
    {
      "condition": "(!SkipSetup)",
      "description": "Complete project setup by running the setup script",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true,
      "manualInstructions": [
        {
          "text": "====================================================================\n\n  To complete setup, run the following commands:\n\n    cd <YourProjectName>\n    dotnet run --project astrolabe-setup/Setup.csproj\n\n  This will:\n    1. Build the backend\n    2. Initialize Rush (monorepo package manager)\n    3. Generate TypeScript client from API\n    4. Install frontend dependencies\n\n  Setup takes approximately 2-3 minutes to complete.\n\n===================================================================="
        }
      ],
      "args": {
        "executable": "dotnet",
        "args": "run --project astrolabe-setup/Setup.csproj"
      }
    }
  ]
}
