<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--#if (IncludeDemoData) -->
    <DefineConstants>$(DefineConstants);IncludeDemoData</DefineConstants>
    <!--#endif -->
    <!--#if (IncludeLocalUsers) -->
    <DefineConstants>$(DefineConstants);IncludeLocalUsers</DefineConstants>
    <!--#endif -->
    <!--#if (IncludeAspire) -->
    <DefineConstants>$(DefineConstants);IncludeAspire</DefineConstants>
    <!--#endif -->
    <!--#if (ManagedSql) -->
    <DefineConstants>$(DefineConstants);ManagedSql</DefineConstants>
    <!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NSwag.AspNetCore" />
    <PackageReference Include="Astrolabe.JSON" />
    <PackageReference Include="Astrolabe.Common" />
    <PackageReference Include="Astrolabe.Schemas" />
    <PackageReference Include="Astrolabe.Validation" />
    <PackageReference Include="Astrolabe.Web.Common" />
    <PackageReference Include="Astrolabe.CodeGen" />
    <PackageReference Include="Astrolabe.SearchState" />
  </ItemGroup>

  <!--#if (IncludeOrleans) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
  </ItemGroup>
  <!--#endif -->

  <!--#if (IncludeLocalUsers) -->
  <ItemGroup>
    <PackageReference Include="Astrolabe.LocalUsers" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <!--#endif -->

  <!--#if (IncludeAspire) -->
  <ItemGroup>
    <ProjectReference Include="..\__ProjectName__.ServiceDefaults\__ProjectName__.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
  <!--#endif -->

  <ItemGroup>
    <Compile Remove="..\ClientApp\**" />
    <EmbeddedResource Remove="..\ClientApp\**" />
    <Content Remove="..\ClientApp\**" />
    <None Remove="..\ClientApp\**" />

    <Compile Remove="astrolabe-setup\**" />
    <EmbeddedResource Remove="astrolabe-setup\**" />
    <Content Remove="astrolabe-setup\**" />
    <None Remove="astrolabe-setup\**" />

    <Compile Remove="..\__ProjectName__.AppHost\**" />
    <EmbeddedResource Remove="..\__ProjectName__.AppHost\**" />
    <Content Remove="..\__ProjectName__.AppHost\**" />
    <None Remove="..\__ProjectName__.AppHost\**" />

    <Compile Remove="..\__ProjectName__.ServiceDefaults\**" />
    <EmbeddedResource Remove="..\__ProjectName__.ServiceDefaults\**" />
    <Content Remove="..\__ProjectName__.ServiceDefaults\**" />
    <None Remove="..\__ProjectName__.ServiceDefaults\**" />
  </ItemGroup>

</Project>
